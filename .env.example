# ===============================================
# 四六级智能 agent - 环境变量模板 (.env.example)
# 复制本文件为 .env 并填入真实值；真实值绝不提交到 Git
# 变量结构与项目文档保持一致，GitHub Secret 使用相同名称
# ===============================================

# AI 网关鉴权 Key（到 EdgeOne AI Gateway 控制台获取，sk- 开头）
# 注意：四六级智学通 Agent 的翻译/作文批改等 AI 能力依赖本 Key，必须填写后才能运行
AI_GATEWAY_API_KEY=sk-your_api_key_here

# AI 网关地址（默认如下，一般无需修改）
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# 使用的模型
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# 高德地图 Key（到高德开放平台 https://lbs.amap.com 创建应用获取）
AMAP_API_KEY=your_amap_key_here
